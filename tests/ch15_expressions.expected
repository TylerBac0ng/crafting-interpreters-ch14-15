--- 15.1 ---
== 1 * 2 + 3 ==
0000    1 OP_CONSTANT         0 '1'
0002    | OP_CONSTANT         1 '2'
0004    | OP_MULTIPLY
0005    | OP_CONSTANT         2 '3'
0007    | OP_ADD
0008    | OP_RETURN
result: 5

== 1 + 2 * 3 ==
0000    1 OP_CONSTANT         0 '1'
0002    | OP_CONSTANT         1 '2'
0004    | OP_CONSTANT         2 '3'
0006    | OP_MULTIPLY
0007    | OP_ADD
0008    | OP_RETURN
result: 7

== 3 - 2 - 1 ==
0000    1 OP_CONSTANT         0 '3'
0002    | OP_CONSTANT         1 '2'
0004    | OP_SUBTRACT
0005    | OP_CONSTANT         2 '1'
0007    | OP_SUBTRACT
0008    | OP_RETURN
result: 0

== 1 + 2 * 3 - 4 / -5 ==
0000    1 OP_CONSTANT         0 '1'
0002    | OP_CONSTANT         1 '2'
0004    | OP_CONSTANT         2 '3'
0006    | OP_MULTIPLY
0007    | OP_ADD
0008    | OP_CONSTANT         3 '4'
0010    | OP_CONSTANT         4 '5'
0012    | OP_NEGATE
0013    | OP_DIVIDE
0014    | OP_SUBTRACT
0015    | OP_RETURN
result: 7.8

